<div class="container">
  <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/profile">Perfil</a></li>
      <li class="breadcrumb-item active" aria-current="page">Admin Usuarios</li>
    </ol>
  </nav>
</div>
<div class="main-container my-5 align-items-center">
  <h1 class="mb-4 text-center">{{title}}</h1>
  {{> message}}
  <div class="btn-plus-User">
    <button type="button" class="btn btn-create" id="btn-create">Crear Usuario</button>
  </div>
  <!-- Scroll vertical y horizontal con Bootstrap -->
  <div class="table-responsive fs-4 " style="max-height: 70vh; overflow-y: auto;">
    <div class="container">
      <form action="/adminUsers" method="POST" class="form-filter">
        <select class="" name="filter" id="filter-option">
          <option value="null">Opción a filtrar</option>
          <option value="identification">Identificación</option>
          <option value="name">Nombre</option>
          <option value="role">Rol</option>
          <option value="status">Estado</option>
        </select>
        <input type="text-capitalize" name="search" id="search" placeholder="Búsqueda">
        <button class="" type="submit">Consultar</button>
      </form>
    </div>
    <table class="table table-bordered table-hover align-middle" id="adminTable">

      <thead class="table-dark">
        <tr>
          <th class="bg-th">#</th>
          <th class="bg-th">Identificación</th>
          <th class="bg-th">Nombre</th>
          <th class="bg-th">Rol</th>
          <th class="bg-th">Correo</th>
          <th class="bg-th">Fecha Creación</th>
          <th class="bg-th">Ultima Modificación</th>
          <th class="bg-th">Estado</th>
          <th class="bg-th">Acción</th>
          <th class="bg-th">Acción</th>
        </tr>
      </thead>
      <tbody>
        {{#each user}}
        <tr>
          <td>{{@index}}</td>
          <td><span class="badge badge-service bg-primary">{{identification}}</span></td>
          <td class="text-uppercase">{{name}}</td>
          <td >{{role}}</td>
          <td >{{email}}</td>
          <td>{{formatDate createdAt}}</td>
          <td>{{formatDate modifiedAt}}</td>
          <td>
            {{#if (eq status "ACTIVO")}}
              <span class="btn btn-success">{{status}}</span>
            {{else}}
              <span class="btn btn-danger text-ligth">{{status}}</span>
            {{/if}}
          </td>
          <td>
            <button type="button" class="btn btn-warning btn-edit"><img src="/assets/images/pen-to-square-solid-white.svg" style="width: 24px; color: white" alt=""></button>
          </td>
          <td>
            <button id="btn-deleteUser" type="button" class="btn btn-danger">Eliminar</button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- 🔹 Modal -->
<div id="createModal" class="modal">
  <div class="modal-content">
    <span class="close" id="close">&times;</span>
    <h3>Nuevo Usuario</h3>

    <form method="post" id="createForm" action="/create_user">
      <label>Identificación</label>
      <input type="number" id="createId" name="identification" required>

      <label>Nombre</label>
      <input type="text" id="createName" name="name" required>

      <label>Rol</label>
      <input type="text" id="createRole" name="role" required>

      <label>Correo</label>
      <input type="email" id="createEmail" name="email" required>

      <label>Contraseña</label>
      <input type="password" id="createPassword" name="password" required>

      <label>Confirmar Contraseña</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required>
      <button class="btn btn-secondary" id="viewPass" type="button">Mostrar Contraseña</button>

      <button type="submit" class="btn btn-success mt-2">Guardar</button>
    </form>
  </div>
</div>



<!-- 🔹 Modal -->
<div id="editModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h3>Editar Usuario</h3>

    {{!-- <form method="post" id="editForm" action="/adminUsers"> --}}
    <form method="post" id="editForm" action="/edit_user">
      <label>Identificación</label>
      <input type="number" id="editId" name="identification" readonly>

      <label>Nombre</label>
      <input type="text" id="editName" name="name" required>

      <label>Rol</label>
      <input type="text" id="editRole" name="role" required>

      <label>Correo</label>
      <input type="email" id="editEmail" name="email" required>

      <label>Estado</label>
      <input type="text" id="editStatus" name="status" required>

      <button type="submit" class="btn btn-success mt-2">Guardar</button>
    </form>
  </div>
</div>

<!-- 🔹 Modal -->
<div id="deleteUserModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h3>Eliminar Usuario</h3>
    <p></p>
    <h5>Esta seguro que desea eliminar el usuario.</h5>
    <p></p>
    <form method="post"  action="/delete_user">
      <input type="text" id="deleteUserId" name="identification" style="border: none;" readonly>
      <div id="infoUser"></div>
      <p></p>
        <button type="submit" class="btn btn-success mt-2 col-md-6">SI</button>
      <div class="row mt-5">
        <button class="btn btn-secondary col-md-6" id="noOptionUser" type="button">NO</button>
      </div>
    </form>
  </div>
</div>

