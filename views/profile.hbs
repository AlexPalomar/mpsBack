<div class="container p-4">
    <div class="row">
        <div class="col-md-12 mx-auto">
            <div class="card">
                <div class="card-body">
                    <h3>Welcome {{user.name}}</h3>
                    <section >
                        <div>identificacion: {{user.identification}}</div>
                        <div>Correo: {{user.email}}</div>
                        <div>Role: {{user.role}}</div>
                        <div>Creación: {{formatDate user.createdAt}}</div>
                        <div>Modificación: {{formatDate user.modifiedAt}}</div>
                    </section>
                    <section class="">
                        <button type="button" class="btn btn-secondary"><a href="/adminServices">Servicios Escalera</a></button>
                        <button type="button" class="btn btn-secondary"><a href="/adminUsers">Admin Usuarios</a></button>
                        <button type="button" class="btn btn-secondary"><a href="/adminReport">Admin Reportes</a></button>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div> 