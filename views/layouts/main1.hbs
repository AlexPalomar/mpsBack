<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>APK MPS</title>

  <!-- Bootstrap CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-1CmrxMRARb6aLqgBO7yyAxTOQE2AKb9GfXnEa5jzOQBEffxvI9A71ef40cxtVbcF"
    crossorigin="anonymous"
  />

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background-image: url("images/fondoPresentacionAPK2.png");
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .main-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 40px;
      flex-wrap: wrap;
      padding: 20px;
    }

    .phone-img {
      width: 100%;
      max-width: 420px;
      filter: drop-shadow(0 20px 20px rgba(0,0,0,0.5));
    }

    .content-box {
      background-color: rgba(0, 0, 0, 0.6);
      border-radius: 15px;
      padding: 40px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
      max-width: 500px;
      text-align: center;
    }

    .download-btn {
      background-color: #ffffff;
      color: #dd6119;
      border: none;
      font-weight: bold;
    }

    .download-btn:hover {
      background-color: #ffe0b3;
      color: #a34714;
    }

    table {
      margin-top: 20px;
      background-color: rgba(255, 255, 255, 0.1);
    }

    th, td {
      color: white;
      text-align: center;
      vertical-align: middle;
    }

    th {
      background-color: rgba(255, 255, 255, 0.2);
    }

    @media (max-width: 768px) {
      .main-container {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  {{{body}}}
  
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-5cmKZp7kD2N/ABcK2PhO+M8lOBz1hF+IvDJTf7OfF7XxAc5uDpJXfuKzpyXDJ42G"
    crossorigin="anonymous"></script>
</body>
</html>

