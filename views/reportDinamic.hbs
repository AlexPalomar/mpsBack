<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Dinámico - Pivot</title>

<!-- Bootstrap -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css">

<!-- jQuery -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.4/dist/jquery.min.js"></script>

<!-- jQuery UI (ANTES de PivotTable) -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/smoothness/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

<!-- PivotTable -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pivottable@2.23.0/dist/pivot.css">
<script src="https://cdn.jsdelivr.net/npm/pivottable@2.23.0/dist/pivot.min.js"></script>

<!-- TableExport -->
<script src="https://cdn.jsdelivr.net/npm/tableexport.jquery.plugin@1.10.24/tableExport.min.js"></script>

<style>
  body { font-family: Arial, sans-serif; margin: 20px; }
  h1 { text-align: center; margin-bottom: 30px; }
  .pivot-container { margin-bottom: 50px; }
  .export-btn { margin-bottom: 10px; }
</style>
</head>
<body>

<div class="container">

  <div class="pivot-container">
    <h1>Usuarios</h1>
    <button class="btn btn-success export-btn" id="exportUsers">Exportar CSV</button>
    <div id="pivotUsers"></div>
  </div>

  <div class="pivot-container">
    <h1>Servicios</h1>
    <button class="btn btn-success export-btn" id="exportServices">Exportar CSV</button>
    <div id="pivotServices"></div>
  </div>

</div>



<script>
  function createPivot(container, url, rows, cols, vals) {
    fetch(url)
      .then(r => {
        if (!r.ok) throw new Error("No autorizado o error API");
        return r.json();
      })
      .then(data => {
        $(container).pivotUI(data, {
          rows: rows,
          cols: cols,
          vals: vals,
          aggregatorName: "Count",
          rendererName: "Table"
        });
      })
      .catch(err => {
        $(container).html(
          '<div class="alert alert-danger">Error cargando datos</div>'
        );
        console.error(err);
      });
  }

  createPivot("#pivotUsers", "http://localhost/api/pivot/users", ["Rol"], ["Estado"], ["Nombre"]);
  createPivot("#pivotServices", "http://localhost/api/pivot/services", ["Tecnico"], ["Estado"], ["IDServicio"]);

  $("#exportUsers").click(function () {
    $("#pivotUsers table").tableExport({ type: 'csv', fileName: 'UsuariosPivot' });
  });

  $("#exportServices").click(function () {
    $("#pivotServices table").tableExport({ type: 'csv', fileName: 'ServiciosPivot' });
  });
</script>

</body>
</html>
